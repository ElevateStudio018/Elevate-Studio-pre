# Apache settings for Loopia (or any Apache host).
# HTTPS is handled by Cloudflare ("Always Use HTTPS"), so there is no HTTPS rule here.

ErrorDocument 404 /404.html
DirectoryIndex index.html

RewriteEngine On

# www.elevatestudio.nu -> elevatestudio.nu
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Old addresses from the previous site
RewriteRule ^om-oss/?$ /om.html [L,R=301]
RewriteRule ^priser/?$ /priser.html [L,R=301]
RewriteRule ^integritetspolicy/?$ /integritet.html [L,R=301]
RewriteRule ^branscher/?$ /hemsida-for-hantverkare.html [L,R=301]
RewriteRule ^sa-fungerar-det/?$ /tjanster/ [L,R=301]
RewriteRule ^vara-hemsidor/?$ /projekt/ [L,R=301]
RewriteRule ^tjanster/(ai-chatt|bokningssystem|offertsystem)/?$ /tjanster/$1.html [L,R=301]
RewriteRule ^tjanster/hemsida-for-hantverkare/?$ /hemsida-for-hantverkare.html [L,R=301]
RewriteRule ^tjanster/seo-for-hantverkare/?$ /tjanster/seo-och-ai-optimering.html [L,R=301]
RewriteRule ^tjanster/underhall-och-support/?$ /tjanster/support-och-underhall.html [L,R=301]
RewriteRule ^tjanster/start/?$ /tjanster/hemsidor.html [L,R=301]
RewriteRule ^(auth|kalender|kontakter|fakturor|utskick|segment|besokare|chatt-insikter|kundportal|cfo|minne|integrationer|ai|portal)(/.*)?$ /admin/ [L,R=301]

# Hide the build tools and server code if they are ever uploaded by mistake
RewriteRule ^(tools|supabase|v2|mejl)(/|$) - [F,L]

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml application/rss+xml
</IfModule>
