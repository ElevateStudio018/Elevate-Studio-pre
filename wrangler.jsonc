// Cloudflare (Workers with static assets): the website is the files in this folder,
// minus what .assetsignore leaves out. Every push to the production branch is published.
{
  "name": "elevate-studio-pre",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Server part for the admin (worker/): meeting invites sent through Gmail. Everything else is static files.
  "main": "worker/index.js",
  "vars": {
    "GMAIL_USER": "elevate.studio018@gmail.com",
    "SUPABASE_URL": "https://halecxdjclrklyufbept.supabase.co",
    "SUPABASE_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhhbGVjeGRqY2xya2x5dWZiZXB0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODMwODYwOTcsImV4cCI6MjA5ODY2MjA5N30.Svt4abfAirAVLNDQkmSaQWep_0Ggz-h4WfOGdb0A4RQ"
  },
  // GMAIL_APP_PASSWORD is a secret set in Cloudflare (Settings -> Variables and Secrets), never here.
  // The site's own addresses. Cloudflare creates the DNS records for these when it publishes.
  "routes": [
    { "pattern": "elevatestudio.nu", "custom_domain": true },
    { "pattern": "www.elevatestudio.nu", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // The server part runs first for every page, so it can send old http:// and www. addresses on to
    // https://elevatestudio.nu (one address for search engines) and reach the Google links directly.
    // Files under /assets and the old addresses in _redirects are served as before, without it.
    "run_worker_first": ["/*", "!/assets/*", "!/om-oss", "!/integritetspolicy", "!/branscher", "!/sa-fungerar-det", "!/vara-hemsidor", "!/tjanster/hemsida-for-hantverkare", "!/tjanster/seo-for-hantverkare", "!/tjanster/underhall-och-support", "!/tjanster/start", "!/auth", "!/kalender", "!/kontakter", "!/fakturor", "!/utskick", "!/segment", "!/besokare", "!/chatt-insikter", "!/kundportal", "!/cfo", "!/minne", "!/integrationer", "!/ai", "!/ai/*", "!/portal", "!/portal/*"]
  }
}
